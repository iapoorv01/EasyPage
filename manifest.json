{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "easyview@easyview.in",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "EasyView — Clarity for Every Brain",
  "short_name": "EasyView",
  "version": "1.1.1.4",
  "description": "Transform any website instantly with AI prompts or single clicks. See the web your way.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "js/constants/tier-schema.js",
      "gemini-service.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/constants/tier-schema.js",
        "dom-utils.js",
        "content.js",
        "js/features/selection-tooltip.js",
        "js/features/text-simplification.js",
        "js/features/jargon-decoder.js",
        "js/features/sensory-shield.js",
        "js/features/dyslexia-mode.js",
        "js/features/text-to-speech.js",
        "js/features/content-privacy-shield.js",
        "js/features/morph-engine.js",
        "inject/index.js",
        "inject/payment-bridge.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "styles.css",
        "inject/sensory.js",
        "inject/network-interceptor.js",
        "sandbox.html",
        "sandbox.js",
        "fonts/kindle/Fast_OpenDyslexic/*.otf",
        "fonts/kindle/Fast_Sans/*.otf",
        "fonts/kindle/Fast_Serif/*.otf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
